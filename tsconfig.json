{
	"compilerOptions": {
		"target": "es2024",
		"module": "node16",
		"moduleResolution": "node16",
		"customConditions": ["development"],
		"rootDir": "./src",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"jsxImportSource": "fluxcord",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
