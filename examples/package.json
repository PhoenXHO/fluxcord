{
	"name": "fluxcord-examples",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"start": "node --env-file=.env dist/index.js",
		"dev": "node --watch --env-file=.env dist/index.js",
		"stop": "powershell -Command \"Get-CimInstance Win32_Process -Filter \\\"Name='node.exe'\\\" | Where-Object { $_.CommandLine -like '*dist/index.js*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }\""
	},
	"dependencies": {
		"discord.js": "^14.25.1",
		"fluxcord": "file:.."
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.9.3"
	}
}
